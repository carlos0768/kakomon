# 必須: Anthropic API キー (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# 生成に使うモデル (Mastra model router 形式)。既定は Claude Opus 5.5
KAKOMON_MODEL=anthropic/claude-opus-5-5
# 添削・弱点分析など軽めの処理用 (未設定なら KAKOMON_MODEL と同じ)
KAKOMON_LIGHT_MODEL=anthropic/claude-opus-5-5

# DB (libSQL/SQLite)。Studio と CLI で同じ DB を使うため絶対パス推奨
KAKOMON_DB_URL=file:./kakomon.db
# Vercel など本番では Turso (リモート libSQL) を使う。CLI も同じ URL を指せば本番 DB を直接操作できる
# KAKOMON_DB_URL=libsql://<db-name>-<org>.aws-ap-northeast-1.turso.io
# TURSO_AUTH_TOKEN=

# 任意: ベクトル検索を有効にする埋め込みモデル (未設定ならキーワード検索のみ)
#   例: voyage/voyage-4-lite (VOYAGE_API_KEY), openai/text-embedding-3-small (OPENAI_API_KEY)
# EMBEDDING_MODEL=voyage/voyage-4-lite
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# 管理者トークン。設定すると Studio・/api/* (作問/分析)・/kakomon/admin/* がこのトークンで保護される。
# 公開環境 (Vercel) では必須。受験者向け /kakomon/* は常に公開。
# KAKOMON_ADMIN_TOKEN=change-me

# テレメトリ送信を止める場合
# MASTRA_TELEMETRY_DISABLED=1
