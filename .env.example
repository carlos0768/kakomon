# 必須: Anthropic API キー (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# 生成に使うモデル (Mastra model router 形式)。既定は Claude Opus 5.5
KAKOMON_MODEL=anthropic/claude-opus-5-5
# 添削・弱点分析など軽めの処理用 (未設定なら KAKOMON_MODEL と同じ)
KAKOMON_LIGHT_MODEL=anthropic/claude-opus-5-5
# 過去問 PDF の読み取り (転記) 用。未設定なら KAKOMON_MODEL。速さ優先なら anthropic/claude-sonnet-5-5 も可
# KAKOMON_EXTRACT_MODEL=anthropic/claude-opus-5-5
# ジョブ開始前の API 疎通確認 (キー・残高) を省略する場合は 1
# KAKOMON_SKIP_PREFLIGHT=1
# 作問を何問ずつのバッチで生成するか (既定 15)。大きくすると出力上限に当たりやすい
# KAKOMON_GENERATE_BATCH=15
# 作問の思考の深さ low / medium / high / xhigh (既定 high)。xhigh は 1 バッチに数十分かかることがある
# KAKOMON_GENERATE_EFFORT=high
# 進捗の更新がこの分数止まった実行中ジョブは失敗扱いにする (既定 15)
# KAKOMON_STALE_JOB_MINUTES=15
# サーバレス (Vercel) 上でも重いジョブの起動を許可する場合は 1 (通常は不要)
# KAKOMON_ALLOW_SERVERLESS_JOBS=1

# DB。ローカル開発は libSQL/SQLite ファイル (Studio と CLI で同じ DB を使うため絶対パス推奨)
KAKOMON_DB_URL=file:./kakomon.db
# 本番 (Vercel) は Supabase の PostgreSQL。Project Settings → Database → Connection string の
# "Transaction pooler" (ポート 6543) を使う。CLI の .env も同じ URL にすれば本番 DB を直接操作できる
# KAKOMON_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# 任意: ベクトル検索を有効にする埋め込みモデル (未設定ならキーワード検索のみ)
#   例: voyage/voyage-4-lite (VOYAGE_API_KEY), openai/text-embedding-3-small (OPENAI_API_KEY)
# EMBEDDING_MODEL=voyage/voyage-4-lite
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# 管理者トークン。設定すると Studio・/api/* (作問/分析)・/kakomon/admin/* がこのトークンで保護される。
# 公開環境 (Vercel) では必須。受験者向け /kakomon/* は常に公開。
# KAKOMON_ADMIN_TOKEN=change-me

# ネット検索 (Anthropic のサーバー側ウェブ検索 + ページ取得)。分析・作問・校閲エージェントが使う。
# 既定で有効。止める場合は 0 (検索は 1,000 回あたり約 $10 の従量課金)
# KAKOMON_WEB_SEARCH=1

# テレメトリ送信を止める場合
# MASTRA_TELEMETRY_DISABLED=1

# アップロードできる過去問 PDF の上限 (MB)。既定 32 (Claude の PDF 入力上限)。Vercel 上は関数の制限で 4.5MB まで
# KAKOMON_MAX_UPLOAD_MB=32
